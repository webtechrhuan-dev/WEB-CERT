# Backend-only settings. Never add real values to the repository or browser bundle.
EXCEL_FILE_PATH=

# GitHub OAuth / Auth.js
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ALLOWED_GITHUB_LOGINS=webtechrhuan-dev
AUTH_EDITOR_GITHUB_LOGINS=webtechrhuan-dev

# GitHub repository containing the permanent Excel workbook
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=
GITHUB_DATA_PATH=CERTIFICADOS_UNIFICADOS_2024-2026.xlsx

# MongoDB Atlas - banco principal (vendas + arquivos de certificados GridFS)
MONGODB_URI=
MONGODB_DB=webcert

# Chave dedicada para criptografia autenticada das senhas PFX (32 bytes em base64)
CERTIFICATE_PASSWORD_ENCRYPTION_KEY=

# Bootstrap de contas internas (opcional; nunca use senhas padrão).
# Use senhas únicas com pelo menos 16 caracteres e mantenha apenas no ambiente do servidor.
BOOTSTRAP_RHUAN_PASSWORD=
BOOTSTRAP_ARTHUR_PASSWORD=
BOOTSTRAP_WESLEY_PASSWORD=
